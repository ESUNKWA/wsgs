# Copier en .env puis renseigner les valeurs.
# Utilisé par l'API (npm run start:dev) ET par docker compose.

APP_PORT=3000

# Base de données (en Docker, DATABASE_HOST est forcé à "db")
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_DB=neurostock

JWT_SECRET=change-me
JWT_TOKEN_EXPIRE=1h

# URL publique de l'API (sert à construire les URLs des images/PDF)
BASE_URL=http://localhost:3000

# Origines autorisées à appeler l'API (front), séparées par des virgules
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Ports publiés par docker compose
API_PORT=3000
DB_PORT=5432

ADMIN_PASSWORD=change-me

# Super admin créé au démarrage s'il n'existe pas
SUPER_ADMIN_NOM=
SUPER_ADMIN_PRENOMS=
SUPER_ADMIN_TELEPHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

OLLAMA_VISION_MODEL=

# Orange SMS API
ORANGE_SMS_USERNAME=
ORANGE_SMS_PASSWORD=
ORANGE_SMS_SENDER=

# WhatsApp (WaSenderAPI)
WASENDER_TOKEN=
